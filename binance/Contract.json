  "strategy": {
    "name": "Failed Breakout and Rejection",
    "description": "當價格突破局部壓力區後未能維持在區域上方，並收盤回到區域下方時，判定為做空訊號候選。",
    "interval": "15m",
    "pressure_zone": {
      "lookback_bars": 8,
      "candidate_rule": "The candle close must be below its high.",
      "grouping": {
        "maximum_close_difference_percent": 1.0,
        "minimum_group_size": 2,
        "selection_rule": "Select the largest group whose closes are within 1% of the lowest close in that group. Break ties by preferring the more recent bars."
      },
      "bounds": {
        "lower": "The minimum high among the selected candles.",
        "upper": "The maximum high among the selected candles."
      },
      "excludes_signal_bars": true
    },
    "signal_conditions": [
      {
        "bar_position": 1,
        "condition": "The close is below the lower boundary of the pressure zone."
      },
      {
        "bar_position": 2,
        "condition": "The close is above the upper boundary of the pressure zone."
      },
      {
        "bar_position": 3,
        "condition": "The close is within the pressure zone, including either boundary."
      },
      {
        "bar_position": 4,
        "condition": "The close is below the lower boundary of the pressure zone."
      }
    ],
    "signal_type": "short_signal_candidate",
    "open_interest": {
      "required": false,
      "description": "未平倉量大幅增加可作為背景資訊觀察，但不是必要的進場條件。"
    },
    "backtest_requirements": [
      "Define the entry time.",
      "Define signal invalidation conditions.",
      "Define exit rules.",
      "Apply the same rule definitions consistently when evaluating performance."
    ]
  }
